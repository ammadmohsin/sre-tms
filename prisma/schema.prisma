// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  HEAD_MANAGER
  DEPARTMENT_HEAD
  EMPLOYEE
  QUALITY_CONTROL_OFFICER
  SUPPLIER
  BUYER
  SHIPPING_AGENT
  COMMERCIAL_DEPT
}

enum AccessLevel {
  WORKER              // Basic access - can mark attendance, report progress
  DEPARTMENT_STAFF    // Department specific access - inventory, orders within dept
  QUALITY_CONTROL     // Inventory management, quality checks, stock control
  COMMERCIAL          // Export/import tracking, shipment management
  SHIPPING            // Shipment details, delivery management
  DEPARTMENT_HEAD     // Full department access, employee management, approvals
  MANAGER             // Full system access, all departments, analytics, reports
  ADMIN               // Super admin - system configuration, user management
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
}

// ==================== USER & EMPLOYEE MANAGEMENT ====================

model User {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  email       String      @unique
  password    String
  role        Role
  accessLevel AccessLevel
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  employee Employee?
  supplier Supplier?
  buyer    Buyer?
}

model Employee {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeCode   String   @unique
  name           String
  email          String   @unique
  phone          String?
  cnic           String   @unique
  dateOfBirth    DateTime
  address        String?
  designation    String
  joiningDate    DateTime @default(now())
  salary         Float
  profilePicture String?
  certifications String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId       String     @unique @db.ObjectId
  user         User       @relation(fields: [userId], references: [id])
  departmentId String     @db.ObjectId
  department   Department @relation(fields: [departmentId], references: [id])

  attendances     Attendance[]
  shifts          EmployeeShift[]
  workingHours    WorkingHours[]
  progressReports ProgressReport[]
}

model Department {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  code        String   @unique
  description String?
  headId      String?  @db.ObjectId
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
  stocks    Stock[]
}

model Attendance {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  date         DateTime
  clockIn      DateTime?
  clockOut     DateTime?
  status       AttendanceStatus
  hoursWorked  Float?
  reason       String? // For absence
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
}

model Shift {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      ShiftType
  startTime String // "08:00"
  endTime   String // "16:00"
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  employeeShifts EmployeeShift[]
}

model EmployeeShift {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime
  createdAt DateTime @default(now())

  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id])
  shiftId    String   @db.ObjectId
  shift      Shift    @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, date])
}

model WorkingHours {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  date       DateTime
  hours      Float
  overtime   Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
}

model ProgressReport {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  weekStart   DateTime
  weekEnd     DateTime
  workDone    String
  workPending String?
  remarks     String?
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id])
}

// ==================== SUPPLY CHAIN MANAGEMENT ====================

model Supplier {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  supplierCode String   @unique
  name         String
  email        String   @unique
  phone        String
  address      String
  city         String
  country      String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String? @unique @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  products       Product[]
  stockMovements StockMovement[]
  supplyOrders   SupplyOrder[]
}

model Buyer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  buyerCode String   @unique
  name      String
  email     String   @unique
  phone     String
  address   String
  city      String
  country   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String? @unique @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  salesOrders SalesOrder[]
}

model SupplyOrder {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber     String      @unique
  orderDate       DateTime    @default(now())
  expectedDate    DateTime?
  status          OrderStatus @default(PENDING)
  totalAmount     Float
  notes           String?
  confirmedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  supplierId String   @db.ObjectId
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  items SupplyOrderItem[]
}

model SupplyOrderItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quantity  Int
  unitPrice Float
  total     Float
  createdAt DateTime @default(now())

  supplyOrderId String      @db.ObjectId
  supplyOrder   SupplyOrder @relation(fields: [supplyOrderId], references: [id])
  productId     String      @db.ObjectId
  product       Product     @relation(fields: [productId], references: [id])
}

// ==================== STOCK/INVENTORY MANAGEMENT ====================

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productCode String   @unique
  name        String
  description String?
  unit        String // meters, kg, pieces
  unitPrice   Float
  purity      Float? // >= 90 or < 90 as per SRS
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id])
  supplierId String?  @db.ObjectId
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  stocks           Stock[]
  stockMovements   StockMovement[]
  supplyOrderItems SupplyOrderItem[]
  salesOrderItems  SalesOrderItem[]
}

model Stock {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  quantity        Int
  minStockLevel   Int      @default(10)
  maxStockLevel   Int      @default(1000)
  reorderLevel    Int      @default(50)
  lastRestockedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productId    String     @unique @db.ObjectId
  product      Product    @relation(fields: [productId], references: [id])
  departmentId String     @db.ObjectId
  department   Department @relation(fields: [departmentId], references: [id])
}

model StockMovement {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  type      StockMovementType
  quantity  Int
  date      DateTime          @default(now())
  reference String? // Order number, shipment number
  notes     String?
  createdAt DateTime          @default(now())

  productId  String    @db.ObjectId
  product    Product   @relation(fields: [productId], references: [id])
  supplierId String?   @db.ObjectId
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
}

// ==================== SALES MANAGEMENT ====================

model SalesOrder {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber   String      @unique
  orderDate     DateTime    @default(now())
  status        OrderStatus @default(PENDING)
  totalAmount   Float
  discount      Float       @default(0)
  tax           Float       @default(0)
  netAmount     Float
  deliveryDate  DateTime?
  notes         String?
  approvedAt    DateTime?
  approvedBy    String?     @db.ObjectId
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  buyerId String @db.ObjectId
  buyer   Buyer  @relation(fields: [buyerId], references: [id])

  items    SalesOrderItem[]
  shipment Shipment?
}

model SalesOrderItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quantity  Int
  unitPrice Float
  discount  Float    @default(0)
  total     Float
  createdAt DateTime @default(now())

  salesOrderId String     @db.ObjectId
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  productId    String     @db.ObjectId
  product      Product    @relation(fields: [productId], references: [id])
}

// ==================== SHIPMENT MANAGEMENT ====================

model Shipment {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  shipmentNumber String         @unique
  status         ShipmentStatus @default(PENDING)
  dispatchDate   DateTime?
  deliveryDate   DateTime?
  trackingNumber String?
  carrier        String?
  notes          String?
  isExported     Boolean        @default(false)
  isReceived     Boolean        @default(false)
  exportedAt     DateTime?
  receivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  salesOrderId String     @unique @db.ObjectId
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
}

// ==================== ANALYTICS & REPORTING ====================

model SalesAnalytics {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  date         DateTime
  totalSales   Float
  totalOrders  Int
  avgOrderValue Float
  createdAt    DateTime @default(now())

  @@unique([date])
}

model StockAnalytics {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  date          DateTime
  totalProducts Int
  totalValue    Float
  lowStockCount Int
  createdAt     DateTime @default(now())

  @@unique([date])
}

model SupplyChainAnalytics {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  date             DateTime
  totalSuppliers   Int
  totalBuyers      Int
  pendingOrders    Int
  completedOrders  Int
  inTransitShipments Int
  createdAt        DateTime @default(now())

  @@unique([date])
}

model Setting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
